{
  "description": "Loomwright quality gates — centralized since v10.0.0. Plugin agents only execute hooks from this file (per-agent frontmatter hooks are silently ignored by Claude Code for plugin-distributed agents). Frontmatter hooks are kept in agent .md files for ~/.claude/agents/ compatibility.",
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "loomwright:code-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/validate-code-review-result.py\" || true"
          },
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/send-telemetry.sh\" || true; printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-token-ledger.sh\" || true"
          }
        ]
      },
      {
        "matcher": "loomwright:qa-executor",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/validate-qa-result.py\" || true"
          },
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/send-telemetry.sh\" || true; printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-token-ledger.sh\" || true"
          }
        ]
      },
      {
        "matcher": "loomwright:worker",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/validate-worker-result.py\" || true"
          },
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-progress-event.sh\" || true"
          }
        ]
      },
      {
        "matcher": "loomwright:execute-manager",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/validate-execute-result.py\" || true"
          },
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-token-ledger.sh\" || true"
          }
        ]
      },
      {
        "matcher": "loomwright:supervisor-runner",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/validate-supervisor-result.py\" || true"
          },
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/send-telemetry.sh\" || true; printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-token-ledger.sh\" || true; bash \"${CLAUDE_PLUGIN_ROOT}/scripts/stamp-requirement-status.sh\" >/dev/null 2>&1 || true"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/send-webhook.sh\" || true"
          }
        ]
      },
      {
        "matcher": "loomwright:plan-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/validate-plan-review-result.py\" || true"
          },
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-token-ledger.sh\" || true"
          }
        ]
      },
      {
        "matcher": "loomwright:launch-pad-runner",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/validate-launch-pad-result.py\" || true"
          },
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-token-ledger.sh\" || true"
          }
        ]
      },
      {
        "matcher": "loomwright:context-keeper",
        "hooks": [
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-token-ledger.sh\" || true"
          }
        ]
      },
      {
        "matcher": "loomwright:orchestrator",
        "hooks": [
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-token-ledger.sh\" || true"
          }
        ]
      },
      {
        "matcher": "loomwright:product-owner",
        "hooks": [
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-token-ledger.sh\" || true"
          }
        ]
      },
      {
        "matcher": "loomwright:qa-strategist",
        "hooks": [
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-token-ledger.sh\" || true"
          }
        ]
      },
      {
        "matcher": "loomwright:red-team-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-token-ledger.sh\" || true"
          }
        ]
      },
      {
        "matcher": "loomwright:review-pr-runner",
        "hooks": [
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-token-ledger.sh\" || true"
          }
        ]
      },
      {
        "matcher": "loomwright:rubric-grader",
        "hooks": [
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-token-ledger.sh\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/validate-code-review-result.py\" --main-session || true"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "A task is being marked complete. Verify from the context that the task appears genuinely done — not just abandoned or skipped. Check: (1) task subject suggests work was done, (2) no obvious incomplete state. Context: $ARGUMENTS. Respond with {\"ok\": true} if complete, or {\"ok\": false, \"reason\": \"...\"} if incomplete.",
            "timeout": 30
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "payload=$(cat); mkdir -p .supervisor/logs && echo \"[$(date -u +%Y-%m-%dT%H:%M:%SZ)] STOP_FAILURE $payload\" >> .supervisor/logs/failures.log || true; printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-lifecycle.sh\" failed || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-dispatch-on-pr-create.sh\" || true"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/reproject-state-on-terminal.sh\" || true"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/worktree-audit.sh\" record || true"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-lifecycle.sh\" heartbeat || true"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/seed-run-owner.sh\" || true"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-lifecycle.sh\" heartbeat || true"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-agent-identity.sh\" || true"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-lifecycle.sh\" heartbeat || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/notify-desktop.sh\" || true; printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-lifecycle.sh\" waiting ask_user || true"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/send-webhook.sh\" || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-test-integrity.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-test-integrity.sh\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-arm.sh\" arm-from-payload || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog|elicitation_complete|elicitation_response",
        "hooks": [
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/notify-desktop.sh\" || true; printf '%s' \"$payload\" | bash \"${CLAUDE_PLUGIN_ROOT}/scripts/emit-lifecycle.sh\" waiting || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "logout|prompt_input_exit|other",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/close-stranded-run.sh\" || true"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-arm.sh\" disarm-session || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-resume.sh\" || true; bash \"${CLAUDE_PLUGIN_ROOT}/scripts/stamp-requirement-status.sh\" >/dev/null 2>&1 || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/set-otel-resource-attrs.sh\" || true"
          }
        ]
      }
    ]
  }
}
