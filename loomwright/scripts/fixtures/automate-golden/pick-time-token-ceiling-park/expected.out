$ ceiling-check "$RF" 2000000
PARK: ledger_unreadable
= 0
$ loop: cp "$PREV" "$ROOT/.ceiling.line"
= 0
$ loop: sed 's/^## Status: running$/## Status: paused/' "$RF" | bash "$H" runfile-write "$RF"
= 0
$ current-set "$RF" --pause-reason token_ceiling
current-set: written
= 0
$ loop: bash "$H" progress-append "$RF" "2026-10-15T11:00:00Z $(cat "$ROOT/.ceiling.line")"
= 0
