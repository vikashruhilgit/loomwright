# next-step.results — drain-owned-drain-started: how test-automate-next-step.sh drives this case through
# automate-next-step.sh (grammar: the test's header). --start drain prints the owned-drain spawn for the running item
# (PR #542); the DRAIN report answers it — the case's on-disk REVIEW_HEAL_RESULT sidecar by path, the start head, the
# real drain-round line (progress_notes) and the terminal line's parenthetical (drain_note) — and drain-result writes the
# start line, the round line, the drain READY line, owned_drain_* and the sidecar's sidecar-check (ok ⇒ no line); the case
# stops there (NEXT_STEP_UNTIL=drain-result), as its steps do.
call: --start drain
expect: spawn
env: NEXT_STEP_UNTIL=drain-result
call: --result "{\"review_heal_result_file\":\"$AD/$RUN_ID.review-heal-result.md\",\"head_sha\":\"35b8303b2d51cd3f5b882522f5a24ffc64bd1560\",\"progress_notes\":[\"drain round 1: 3 validated claude[bot] findings (session-pid 0/1 guard; PPID=1 fallback; changelog headline) → fix 5bcf89d pushed (test-run-lock 82/0); 0 dismissed\"],\"drain_note\":\"converged, 1 round, 1 fix cycle; ci green on 5bcf89d; claude-review on 5bcf89d: no new findings; rules_gate none; 4 already-addressed dismissed\"}"
expect: none
