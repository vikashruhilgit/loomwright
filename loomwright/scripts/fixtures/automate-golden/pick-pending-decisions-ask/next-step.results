# next-step.results — pick-pending-decisions-ask: how test-automate-next-step.sh drives this case through
# automate-next-step.sh (grammar: the test's header). The case is PICK's pending-decisions step alone
# (NEXT_STEP_FROM=pending, NEXT_STEP_UNTIL=pending): dismissed-pending reads 2, the per-finding draft is asked
# under AUT-PENDING, the summary draft in a call of its own under AUT-SUMMARY; the owner's answers (both
# follow-up, the real 10:19:53Z choices) are fixed input; each answer is one dismissed-decide.
env: NEXT_STEP_FROM=pending NEXT_STEP_UNTIL=pending
call: --session-id auto-2026-10-15-040641
expect: ask
env: NEXT_STEP_FROM=
call: --result '{"answers":["Follow-up (keep draft)"]}'
expect: ask
call: --result '{"answers":["Keep summary"]}'
expect: none
