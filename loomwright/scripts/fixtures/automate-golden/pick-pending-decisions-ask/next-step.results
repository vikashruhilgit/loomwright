# next-step.results — pick-pending-decisions-ask: how test-automate-next-step.sh drives this case through
# automate-next-step.sh (grammar: the test's header). The case is PICK's pending-decisions step alone
# (NEXT_STEP_FROM=pending, NEXT_STEP_UNTIL=pending): the summary draft, undecided on disk from before the
# summary auto-keep, is recorded follow-up first with no question (dismissed-decide --auto); dismissed-pending
# then reads 1 and only the per-finding draft is asked, under AUT-PENDING — no AUT-SUMMARY ask; the owner's
# answer (follow-up, the real 10:19:53Z choice) is fixed input and is one dismissed-decide.
env: NEXT_STEP_FROM=pending NEXT_STEP_UNTIL=pending
call: --session-id auto-2026-10-15-040641
expect: ask
env: NEXT_STEP_FROM=
call: --result '{"answers":["Follow-up (keep draft)"]}'
expect: none
