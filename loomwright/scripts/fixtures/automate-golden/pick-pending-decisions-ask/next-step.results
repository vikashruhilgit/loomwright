# next-step.results — pick-pending-decisions-ask: how test-automate-next-step.sh drives this case through
# automate-next-step.sh (grammar: the test's header). The case is PICK's pending-decisions step alone
# (NEXT_STEP_FROM=pending, NEXT_STEP_UNTIL=pending): both undecided drafts on disk — the per-finding draft and the
# summary written before the summary auto-keep — are recorded follow-up with no question (dismissed-decide --auto,
# per-finding first); dismissed-pending then reads 0, so nothing is asked (no AUT-PENDING, no AUT-SUMMARY) and the
# step stops at its boundary.
env: NEXT_STEP_FROM=pending NEXT_STEP_UNTIL=pending
call: --session-id auto-2026-10-15-040641
expect: none
