# deterministic scratch commits: main = base, feature/af39a-sweep = one commit on top (the PR head)
printf 'golden scratch base\n' > README.md
git add README.md && git commit -q -m base
# name the base ON DISK, as a clone records it: gate-eval condition 6 resolves its diff base via
# resolve-base-branch.sh (origin/HEAD step — no remote, so no set-head/network) and
# classify-risk.sh diffs against origin/<base>, which must exist. Never a hardcoded fallback.
git update-ref refs/remotes/origin/main main
git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main
git checkout -q -b feature/af39a-sweep
mkdir -p loomwright/commands
printf 'golden high-risk surface\n' > loomwright/commands/automate.md
git add loomwright/commands/automate.md && git commit -q -m change
