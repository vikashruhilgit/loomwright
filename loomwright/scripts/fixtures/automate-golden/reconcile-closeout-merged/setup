# deterministic scratch checkout with a bare origin (closeout's sync, trail-pr's push)
git init -q --bare "$(cd .. && pwd)/origin.git"
printf 'golden scratch base\n' > README.md
git add README.md && git commit -q -m base
git remote add origin "$(cd .. && pwd)/origin.git"
git push -q origin main
git fetch -q origin
git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main
