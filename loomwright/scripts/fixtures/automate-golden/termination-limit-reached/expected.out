$ remaining "$RF"
2
= 0
$ loop: sed 's/^## Status: running$/## Status: paused/' "$RF" | bash "$H" runfile-write "$RF"
= 0
$ current-set "$RF" --pause-reason limit_reached
current-set: written
= 0
$ loop: bash "$H" progress-append "$RF" "2026-07-06T19:40:00Z limit_reached — 4 item(s) processed; remaining: $(bash "$H" remaining "$RF")"
= 0
