# next-step.results — learning-emit-end-of-drain: how test-automate-next-step.sh drives this case through
# automate-next-step.sh (grammar: the test's header). The case is learning-emit alone (NEXT_STEP_FROM / _UNTIL =
# learning-emit), called twice (idempotent): the DRAIN report's REVIEW_HEAL_RESULT (READY, fix_cycles 1, no repeat
# failure / unresolved feedback), the supervisor-result sidecar's heal_iterations 3 for PR #555 (fixed input, a file: row) and the
# one gh pr view … files fetch (fixed input, a gh: row — the 2-path excerpt). The ledger, projected, must equal the case's
# expected.out block (out:); the run file is unchanged.
file: "$AD/$RUN_ID.supervisor-result.md" $'SUPERVISOR_RESULT:\n  schema_version: 1\n  pr_url: https://github.com/vikashruhilgit/loomwright/pull/555\n  heal_iterations: 3\n'
gh: 0	pr view https://github.com/vikashruhilgit/loomwright/pull/555 --json files,additions,deletions,changedFiles	{"files":[{"path":"loomwright/scripts/automate-trail.sh"},{"path":"loomwright/scripts/worktree-salvage.sh"}],"additions":1528,"deletions":40,"changedFiles":16}
env: NEXT_STEP_FROM=learning-emit NEXT_STEP_UNTIL=learning-emit
call: --result '{"review_heal_result":"REVIEW_HEAL_RESULT:\n  schema_version: 2\n  decision: READY\n  iterations: 2\n  issues_fixed: 3\n  remaining_issues: 0\n  pr_url: \"https://github.com/vikashruhilgit/loomwright/pull/555\"\n  notified: true\n  rounds: 2\n  max_rounds: 5\n  fix_cycles: 1\n  repeat_check_failure: false\n  unresolved_bot_feedback: false\n  termination_reason: converged\n  rules_gate: none","ready_sha":"953c2d1bbf14"}'
expect: none
call: --result '{"review_heal_result":"REVIEW_HEAL_RESULT:\n  schema_version: 2\n  decision: READY\n  iterations: 2\n  issues_fixed: 3\n  remaining_issues: 0\n  pr_url: \"https://github.com/vikashruhilgit/loomwright/pull/555\"\n  notified: true\n  rounds: 2\n  max_rounds: 5\n  fix_cycles: 1\n  repeat_check_failure: false\n  unresolved_bot_feedback: false\n  termination_reason: converged\n  rules_gate: none","ready_sha":"953c2d1bbf14"}'
expect: none
out: env LC_ALL=C sort "$ROOT/.supervisor/postmortem/results.jsonl" | jq -c '{source, automate_key, review_rounds, self_heal_rounds, categories: [.categories[]? | .category? // .]}'
